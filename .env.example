# Copy to .env and edit. Compose interpolates these into compose.mqtt.yml.
# Do not put the broker password in this file. The password is only the host
# file named by MQTT_PASSWORD_HOST_FILE (mode 0600, nothing else in it).
# Never commit a filled-in .env.

# Host address that publishes the read-only API. Not 0.0.0.0.
PUBLISH_ADDRESS=192.168.86.20

# Host paths. The data directory must be writable by uid 10001.
DATA_HOST_PATH=/srv/neurio-recorder/data
BACKUP_HOST_PATH=/srv/neurio-recorder/backups

# Broker. MQTT_BROKER_PORT defaults to 1883 inside compose.mqtt.yml.
MQTT_BROKER_HOST=192.168.86.7
MQTT_USERNAME=
MQTT_PASSWORD_HOST_FILE=/srv/neurio-recorder/mqtt_password

# Optional. Default 3900 (one hour plus five minutes).
# NEURIO_HOURLY_STALE_AFTER_SECONDS=3900

# Cloud ingest (optional): hourly energy history pulled from the Neurio
# cloud into cloud_hourly_records, alongside the MQTT records. Disabled
# unless both credentials are set.
# NEURIO_CLIENT_ID=
# NEURIO_CLIENT_SECRET_FILE=/run/secrets/neurio_cloud_secret
# NEURIO_CLIENT_SECRET is the inline alternative. Set only one of them.
# Optional knobs (process defaults shown):
# NEURIO_CLOUD_SENSOR_ID=
# NEURIO_CLOUD_SYNC_INTERVAL_SECONDS=3600
# NEURIO_CLOUD_TAIL_HOURS=48
# NEURIO_CLOUD_HARVEST_FROM=2016-01-01T00:00:00Z
# NEURIO_CLOUD_MAX_REQUESTS_PER_HOUR=72

# Copy to .env and edit. Compose interpolates these into compose.yml.
# Do not put a Home Assistant token in this file. The token is a separate
# file mounted read-only at /run/secrets/ha_token. Never commit the token file
# or a filled-in .env.

# Host address that publishes the read-only API. Not 0.0.0.0.
PUBLISH_ADDRESS=192.168.1.20

# Host paths. The data directory must be writable by uid 10001.
DATA_HOST_PATH=/srv/neurio-recorder/data
BACKUP_HOST_PATH=/srv/neurio-recorder/backups
HA_TOKEN_HOST_FILE=/srv/neurio-recorder/ha_token

# Home Assistant origin only: no userinfo, path, query, or fragment.
# Plain HTTP is accepted only for a literal loopback or RFC1918 address, and
# only with HA_ALLOW_RFC1918_HTTP=accept-unencrypted-bearer (set in compose.yml).
# That flag means the bearer travels unencrypted on this hop. DNS names are rejected.
HA_URL=http://192.168.1.10:8123
HA_ENTITY=sensor.neurio_raw
HA_SOURCE_ID=ha-relay:sensor.neurio_raw

# Inside the container these are fixed by compose.yml:
# SOURCE_MODE=homeassistant
# HA_TOKEN_FILE=/run/secrets/ha_token
# BIND_ADDRESS=0.0.0.0
# BIND_PORT=8095
# ALLOW_CONTAINER_WILDCARD_BIND=host-publish-pinned
# DATA_DIR=/data
# NEURIO_POLL_INTERVAL_SECONDS=15
# NEURIO_POLL_TIMEOUT_SECONDS=3
# NEURIO_POLL_MAX_BACKOFF_SECONDS=300
# NEURIO_TIMEZONE=America/Chicago
# NEURIO_TOPOLOGY_VERIFIED=false
# NEURIO_CONSUMPTION_SOURCE=consumption_channel
# NEURIO_REDACT_IDENTITY=true
# NEURIO_RAW_RETENTION_DAYS=0
#
# NEURIO_RAW_RETENTION_DAYS=0 keeps raw JSON indefinitely. If the variable is
# omitted, the process default is 14 days and older raw_json values are cleared.
# Do not set NEURIO_URL in homeassistant mode.
#
# Device mode, instead of the block above:
# SOURCE_MODE=device
# NEURIO_URL=http://192.168.1.50/current-sample
# BIND_ADDRESS=127.0.0.1
# BIND_PORT=8095
# DATA_DIR=/absolute/path/to/data
#
# MQTT mode, instead of the blocks above. The recorder subscribes to the
# ESPHome Neurio bridge topics on this broker and acknowledges hourly
# records after storing them:
# SOURCE_MODE=mqtt
# MQTT_BROKER_HOST=192.168.1.10
# BIND_ADDRESS=127.0.0.1
# BIND_PORT=8095
# DATA_DIR=/absolute/path/to/data
# Do not set NEURIO_URL in mqtt mode, and do not set the Home Assistant
# variables. The broker login is optional; if the broker requires one, set
# MQTT_USERNAME and MQTT_PASSWORD_FILE (a file holding only the password,
# like the HA token file). MQTT_PASSWORD is the inline alternative.
# Set only one of them.
#
# Optional knobs (process defaults shown):
# NEURIO_POLL_JITTER_RATIO=0.2
# NEURIO_POLL_MIN_GAP_SECONDS=1
# NEURIO_STALE_AFTER_SECONDS=60
# NEURIO_SAMPLE_STALE_SKEW_SECONDS=180
# NEURIO_DEVICE_AHEAD_SKEW_SECONDS=30
# NEURIO_MAX_ALLOCATABLE_GAP_SECONDS=45
# NEURIO_POLL_LOG_RETENTION_DAYS=30
# NEURIO_GENERATION_REGISTER=unset
# NEURIO_HOUSEHOLD_CHANNEL_READS=true
# NEURIO_MAX_RESPONSE_BYTES=1000000
# NEURIO_ROLE_NET_IDENTITY=
# NEURIO_ROLE_GENERATION_IDENTITY=
# NEURIO_ROLE_CONSUMPTION_IDENTITY=
# HA_TOKEN is an alternative to HA_TOKEN_FILE. Set only one of them.
